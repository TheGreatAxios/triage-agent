{
  "name": "triage-agent",
  "version": "0.6.28",
  "private": true,
  "license": "MIT",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegreataxios/triage-agent.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bun run db:migrate:remote && wrangler deploy --keep-vars",
    "deploy:skip-migrate": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply triage-agent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply triage-agent-db --remote",
    "mcp:add": "bun run scripts/add-mcp.ts",
    "mcp:list": "bun run scripts/list-mcp.ts",
    "mcp:remove": "bun run scripts/remove-mcp.ts",
    "telegram:add": "bun run scripts/telegram-add.ts",
    "telegram:remove": "bun run scripts/telegram-remove.ts",
    "telegram:list": "bun run scripts/telegram-list.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@ai-sdk/xai": "^1.2.18",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "ai": "^6.0.168",
    "hono": "^4.12.15",
    "workers-ai-provider": "^3.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "bun-types": "^1.2.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.85.0"
  }
}
