{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "triage-agent",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "triage-agent-db",
			"database_id": "${DATABASE_ID}",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "ARCHIVE",
			"bucket_name": "triage-agent-archive"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
