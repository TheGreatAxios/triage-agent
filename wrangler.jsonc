{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "triage-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "triage-agent-db",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "ARCHIVE",
			"bucket_name": "triage-agent-archive"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
		  "enabled": true,
		  "head_sampling_rate": 1,
		  "persist": true,
		  "invocation_logs": true
		},
		"traces": {
		  "enabled": true,
		  "persist": true,
		  "head_sampling_rate": 1
		}
	}
}
